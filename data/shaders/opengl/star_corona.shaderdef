# Procedural animated stellar corona, chromosphere atmosphere, and solar prominence flares

Shader star_corona

PushConstant vec4 starColor
PushConstant float uTime

Buffer DrawData binding=1

Vertex "star_corona.vert"
Fragment "star_corona.frag"
