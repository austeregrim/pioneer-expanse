Shader gassphere_base

Texture samplerCube texture0

Buffer LightData binding=0
Buffer DrawData binding=1
Buffer BaseSphereData binding=2

PushConstant int NumShadows binding=0
PushConstant float enhancedGraphics
PushConstant float uTime
PushConstant vec4 ggParams
PushConstant vec4 ggStormParams

Vertex "gassphere_base.vert"
Fragment "gassphere_base.frag"
