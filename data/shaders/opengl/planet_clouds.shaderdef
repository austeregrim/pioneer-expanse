# Procedural terrestrial planet cloud layer (Enhanced Graphics)

Shader planet_clouds

PushConstant vec4 cloudParams
PushConstant vec4 cloudTint
PushConstant vec4 weatherParams
PushConstant vec4 cloudScale
PushConstant vec4 cloudGeom
PushConstant vec3 cloudCenter
PushConstant vec4 layerParams
PushConstant vec4 flashCell
PushConstant vec3 camDirObj
PushConstant float uTime
PushConstant float cloudQuality

Buffer LightData binding=0
Buffer DrawData binding=1

Vertex "planet_clouds.vert"
Fragment "planet_clouds.frag"
